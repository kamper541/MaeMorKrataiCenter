{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mmk-frontend-client",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/scene/*.mp4"]
  }
}
